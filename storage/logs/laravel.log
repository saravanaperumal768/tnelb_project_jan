","form_code":"<pre class=sf-dump id=sf-dump-1966088358 data-indent-pad=\"  \"><span class=sf-dump-note>App\\Models\\MstLicence</span> {<a class=sf-dump-ref>#847</a><samp data-depth=1 class=sf-dump-expanded>
  #<span class=sf-dump-protected title=\"Protected property\">connection</span>: \"<span class=sf-dump-str title=\"5 characters\">pgsql</span>\"
